# ============================================================
# VISONS Mobile — Variables de entorno
# Cambia EXPO_PUBLIC_API_URL a la IP real del servidor cuando
# despliegues. En desarrollo usa la IP de tu máquina en la red
# local (NO localhost — el emulador/dispositivo no lo resuelve)
# ============================================================

# Backend 1 — Spring Boot (dev-2.0 corre en puerto 9090)
EXPO_PUBLIC_API_URL=http://10.0.2.2:9090/api/v1

# Backend 2 — Analítico Flask (puerto 5000)
EXPO_PUBLIC_BA_URL=http://10.0.2.2:5000/api/v1

# Timeout de peticiones en milisegundos
EXPO_PUBLIC_TIMEOUT=10000
