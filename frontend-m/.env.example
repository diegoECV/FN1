# ============================================================
# VISONS Mobile — Variables de entorno (plantilla)
# Copia este archivo como .env y rellena con tus valores
# ============================================================

# Backend 1 — Spring Boot
# En desarrollo local (emulador Android): http://10.0.2.2:9090/api/v1
# En desarrollo local (dispositivo físico): http://<TU-IP-LOCAL>:9090/api/v1
# En producción AWS: http://<IP-EC2-O-ELB>:9090/api/v1
EXPO_PUBLIC_API_URL=http://localhost:9090/api/v1

# Backend 2 — Analítico Flask
EXPO_PUBLIC_BA_URL=http://localhost:5000/api/v1

# Timeout de peticiones en milisegundos
EXPO_PUBLIC_TIMEOUT=10000
